# Example environment for the optional cloud dashboard.
# Copy to .env and fill in — never commit the real file.

# MCP_SHIELD_HOST=0.0.0.0
# MCP_SHIELD_PORT=8000
# MCP_SHIELD_DB_PATH=./data/mcp_shield_cloud.db
# DATABASE_URL=postgres://user:pass@host:5432/mcp_shield

# MCP_SHIELD_APP_URL=http://localhost:8000
# MCP_SHIELD_SMTP_HOST=
# MCP_SHIELD_SMTP_PORT=587
# MCP_SHIELD_SMTP_USER=
# MCP_SHIELD_SMTP_PASSWORD=
# MCP_SHIELD_SMTP_FROM=noreply@example.com
# MCP_SHIELD_SMTP_SSL=false

# MCP_SHIELD_BOOTSTRAP_EMAIL=admin@localhost
# MCP_SHIELD_BOOTSTRAP_PASSWORD=   # leave empty to auto-generate on first boot

# Demo only — leave unset in real deployments:
# MCP_SHIELD_ALLOW_SELF_UPGRADE=0
